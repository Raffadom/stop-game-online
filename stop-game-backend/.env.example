# ===================================
# STOP GAME BACKEND - ENVIRONMENT VARIABLES
# ===================================
# 🔒 IMPORTANTE: 
# 1. Copie este arquivo para .env
# 2. Preencha com suas credenciais reais
# 3. NUNCA commite o arquivo .env

# ===================================
# 🔥 FIREBASE CONFIGURATION (OBRIGATÓRIO)
# ===================================
# Service Account JSON completo do Firebase
# Obter em: Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"seu-projeto-id"...}

# ID do projeto Firebase (mesmo do JSON acima)
FIREBASE_PROJECT_ID=seu-projeto-firebase-id

# ===================================
# 🖥️ SERVER CONFIGURATION
# ===================================
# Porta onde o servidor irá rodar
PORT=3001

# Ambiente de execução (development, production, test)
NODE_ENV=development

# ===================================
# 🔐 SECURITY KEYS (GERAR CHAVES FORTES)
# ===================================
# Chave secreta para JWT (gerar com: openssl rand -base64 32)
JWT_SECRET=sua_chave_jwt_muito_forte_e_aleatoria_aqui

# Chave para sessões (gerar com: openssl rand -base64 32)
SESSION_SECRET=sua_chave_de_sessao_muito_forte_e_aleatoria

# ===================================
# 🛡️ RATE LIMITING & SECURITY
# ===================================
# Janela de tempo para rate limiting (ms) - 15 minutos
RATE_LIMIT_WINDOW_MS=900000

# Máximo de requests por janela de tempo
RATE_LIMIT_MAX_REQUESTS=100

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,https://seu-dominio.netlify.app

# ===================================
# 📊 MONITORING & LOGGING
# ===================================
# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# Sentry DSN para monitoramento de erros (opcional)
SENTRY_DSN=https://sua-sentry-dsn@sentry.io/projeto

# ===================================
# 🔧 FEATURES FLAGS
# ===================================
# Ativar modo de debug
DEBUG_MODE=true

# Ativar limpeza automática de salas órfãs
ENABLE_ROOM_CLEANUP=true

# Intervalo de limpeza automática (ms) - 1 minuto
CLEANUP_INTERVAL_MS=60000

# ===================================
# 🌐 PRODUCTION OVERRIDES
# ===================================
# Chave opcional do TMDB para filmes, séries e novelas.
# Sem ela, o sistema usa o TVMaze como alternativa sem chave.
TMDB_API_KEY=

# Endpoint opcional compatível com a API do Datamuse para temas personalizados.
VALIDATION_API_URL=https://api.datamuse.com/words

# Forçar redirecionamento HTTPS (production only)
SSL_REDIRECT=false

# Tempo limite para conexões WebSocket (ms)
WEBSOCKET_TIMEOUT=30000

# Máximo de jogadores por sala
MAX_PLAYERS_PER_ROOM=8

# ===================================
# 📝 EXAMPLE VALUES (SUBSTITUIR)
# ===================================
# PORT=3001
# NODE_ENV=development  
# JWT_SECRET=k8mP9nQ2xR5vW8zA1bE4gH7jL0oN3qS6tY9uI2eR5tY8uI1oP4sA7dF0gH3jK6mN
# SESSION_SECRET=mN6qS9tY2eR5uI8oP1aD4gH7jL0kM3nQ6sV9yB2eE5hK8lO1pS4tW7zA0bC3fG6i
# FIREBASE_PROJECT_ID=stop-game-12345
# CORS_ORIGINS=http://localhost:5173,https://stop-game-frontend.netlify.app